---
import Logo from "@/components/Logo.astro";
import menu from "@/config/menu.json";
import { getEntry } from "astro:content";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { main }: { main: NavigationLink[] } = menu;
const { pathname } = Astro.url;
const contact = await getEntry("contact", "-index");
const admissionLink = contact?.data.admission.button.link ?? "/contact";
---

<header class="header">
  <nav class="navbar container">
    <!-- logo -->
    <div class="order-0">
      <Logo src="/images/logos/logo-azul.webp" />
    </div>
    <!-- navbar toggler -->
    <input id="nav-toggle" type="checkbox" class="hidden" />
    <label
      id="show-button"
      for="nav-toggle"
      class="order-2 flex cursor-pointer items-center lg:order-1 lg:hidden"
    >
      <svg class="h-6 fill-current" viewBox="0 0 20 20">
        <title>Menu Open</title>
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
    </label>
    <label
      id="hide-button"
      for="nav-toggle"
      class="order-2 hidden cursor-pointer items-center lg:order-1"
    >
      <svg class="h-6 fill-current" viewBox="0 0 20 20">
        <title>Menu Close</title>
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"></polygon>
      </svg>
    </label>
    <!-- /navbar toggler -->

    <ul
      id="nav-menu"
      class="navbar-nav order-3 hidden w-full lg:order-1 lg:flex lg:w-auto lg:space-x-2"
    >
      {
        main.map((menu) => (
          <>
            {menu.hasChildren ? (
              <li class="nav-item nav-dropdown group relative cursor-pointer dropdown-button">
                <span
                  class={`nav-link inline-flex items-center ${
                    menu.children?.map(({ url }) => url).includes(pathname) ||
                    menu.children
                      ?.map(({ url }) => `${url}/`)
                      .includes(pathname)
                      ? "active"
                      : ""
                  }`}
                >
                  {menu.name}
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                  </svg>
                </span>
                <ul
                  id="dropdown"
                  class="nav-dropdown-list mx-auto hidden duration-300 lg:invisible lg:absolute lg:block lg:h-auto lg:w-54 lg:opacity-0 lg:group-hover:visible lg:group-hover:opacity-100"
                >
                  {menu.children?.map((child) => (
                    <li class="nav-dropdown-item">
                      <a
                        href={child.url}
                        class={`nav-dropdown-link block ${
                          (pathname === `${child.url}/` ||
                            pathname === child.url) &&
                          "text-primary"
                        }`}
                      >
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav-item">
                <a
                  href={menu.url}
                  class={`nav-link inline-block lg:block ${
                    (pathname === `${menu.url}/` || pathname === menu.url) &&
                    "active"
                  }`}
                >
                  {menu.name}
                </a>
              </li>
            )}
          </>
        ))
      }
      <li class="nav-item mt-2 lg:hidden">
        <a class="btn btn-primary btn-sm" href={admissionLink} target="_blank" rel="noopener noreferrer">Inscripciones</a>
      </li>
    </ul>
    <div class="order-1 ml-auto hidden items-center md:order-2 md:ml-0 lg:flex">
      <a class="btn btn-primary btn-sm" href={admissionLink} target="_blank" rel="noopener noreferrer">Inscripciones</a>
    </div>
  </nav>
</header>

<script is:inline>
  const initHeader = () => {
    const navToggle = document.querySelector("#nav-toggle");
    const navMenu = document.querySelector("#nav-menu");

    const updateBodyScroll = () => {
      if (!(navToggle instanceof HTMLInputElement)) return;
      if (window.innerWidth < 1024 && navToggle.checked) {
        document.body.style.overflow = "hidden";
      } else {
        document.body.style.overflow = "";
      }
    };

    const closeMobileMenu = () => {
      if (!(navToggle instanceof HTMLInputElement)) return;
      navToggle.checked = false;
      updateBodyScroll();
    };

    if (navToggle instanceof HTMLInputElement && !navToggle.dataset.bound) {
      navToggle.addEventListener("change", updateBodyScroll);
      navToggle.dataset.bound = "true";
    }

    if (navMenu && !navMenu.dataset.bound) {
      navMenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMobileMenu);
      });
      navMenu.dataset.bound = "true";
    }

    if (!document.body.dataset.navEscBound) {
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeMobileMenu();
        }
      });
      document.body.dataset.navEscBound = "true";
    }

    if (!document.body.dataset.navResizeBound) {
      window.addEventListener("resize", updateBodyScroll, { passive: true });
      document.body.dataset.navResizeBound = "true";
    }

    updateBodyScroll();

    document.querySelectorAll(".dropdown-button").forEach((button) => {
      if (button.dataset.bound) return;
      button.addEventListener("click", (e) => {
        const dropdown = e.currentTarget.querySelector(".nav-dropdown-list");
        if (dropdown) {
          dropdown.classList.toggle("hidden");
        }
      });
      button.dataset.bound = "true";
    });

    // Sticky header functionality
    const header = document.querySelector(".header");
    if (!header) {
      return;
    }

    if (!header.dataset.stickyBound) {
      const updateHeader = () => {
        if (window.scrollY > 0) {
          header.classList.add("header-sticky");
        } else {
          header.classList.remove("header-sticky");
        }
      };

      // Apply initial state
      updateHeader();

      // Throttled scroll handler
      let ticking = false;
      const scrollHandler = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            updateHeader();
            ticking = false;
          });
        }
      };

      window.addEventListener("scroll", scrollHandler, { passive: true });
      header.dataset.stickyBound = "true";
    }
  };

  // Run on initial load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeader);
  } else {
    initHeader();
  }

  // Run on Astro page navigation
  document.addEventListener("astro:page-load", initHeader);
</script>
