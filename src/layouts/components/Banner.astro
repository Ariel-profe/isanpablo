---
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Slider from "./Slider.astro";

type Props = {
  banner: CollectionEntry<"homepage">["data"]["banner"];
};
const { banner } = Astro.props;
const { eyebrow, title, button, images, content, highlights } = banner;
---

<section class="section banner relative flex items-center">
  <div class="container">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
      <div class="flex-1 space-y-6">
        {
          eyebrow && (
            <span class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1.5 text-xs font-medium text-primary sm:px-4 sm:text-sm">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
              {eyebrow}
            </span>
          )
        }
        <h1 class="text-3xl md:text-4xl lg:text-5xl 2xl:text-6xl font-bold leading-tight" set:html={markdownify(title)} />

        {content && <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-2xl" set:html={markdownify(content)} />}

        {
          button?.enable && (
            <div class="pt-4">
              <a class="btn btn-primary shadow-lg hover:shadow-md transition-all" href={button.link}>
                {button.label}
              </a>
            </div>
          )
        }

        {
          highlights && highlights.length > 0 && (
            <dl class="grid max-w-xl grid-cols-3 gap-4 border-t border-border pt-6">
              {highlights.map((item) => (
                <div>
                  <dt class="font-secondary text-lg font-bold text-dark md:text-2xl">{item.value}</dt>
                  <dd class="mt-1 text-xs leading-snug text-slate-500 md:text-sm">{item.label}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
      <div class="w-full min-w-0 flex-1 max-w-2xl">
        <div class="relative">
          <div class="absolute -inset-6 bg-linear-to-br from-primary/10 to-primary/5 rounded-3xl blur-3xl opacity-60"></div>
          <!-- <Image
            class="relative w-full h-auto object-cover rounded-2xl lg:hover:shadow-2xl transition-shadow"
            alt="banner"
            src={image}
            width={603}
            height={396}
          /> -->
          <Slider list={images} />
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 -z-10 w-1/3 h-1/3 bg-linear-to-bl from-primary/5 to-transparent blur-3xl"></div>
  <div class="absolute bottom-0 left-0 -z-10 w-1/3 h-1/3 bg-linear-to-tr from-primary/5 to-transparent blur-3xl"></div>
  
  <Image
    class="banner-shape absolute -top-28 right-0 -z-1 w-full max-w-[30%]"
    alt="banner"
    src="/images/banner-shape.png"
    width={496}
    height={466}
  />
</section>
