---
import {
  Swiper,
  SwiperPagination,
  SwiperSlide,
  SwiperWrapper,
} from "astro-swiper";
import { Image } from "astro:assets";
import type { SwiperOptions } from "swiper/types";

type Props = {
  list: string[];
  // "gallery" assumes 20:7 photos (1000x350); "logos" keeps a fixed-height box with contained images
  variant?: "gallery" | "logos";
};

const { list, variant = "gallery" } = Astro.props;
const isLogos = variant === "logos";

const swiperOptions: SwiperOptions = {
  pagination: {
    el: ".testimonial-slider-pagination",
    type: "bullets",
    clickable: true,
    dynamicBullets: true,
  },
  autoplay: {
    delay: 3000,
    disableOnInteraction: false,
  },
  loop: true,
  slidesPerView: 1,
};
---

<div class="cursor-grab">
  <Swiper options={swiperOptions} class={isLogos ? "reviews-carousel relative" : "relative pb-8!"}>
    <SwiperWrapper>
      {
        list.map((item: string) => (
          <SwiperSlide class={isLogos ? "swiper-slide-fixed-height" : ""}>
            <Image
              src={item}
              alt={item}
              class={
                isLogos
                  ? "w-full h-87.5 rounded-3xl object-contain"
                  : "w-full h-auto aspect-[20/7] rounded-2xl object-cover"
              }
              width={1000}
              height={350}
            />
          </SwiperSlide>
        ))
      }
    </SwiperWrapper>
    <SwiperPagination class="testimonial-slider-pagination" />
  </Swiper>
</div>
