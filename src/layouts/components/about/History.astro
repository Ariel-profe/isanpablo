---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";

type Props = {
  history: NonNullable<CollectionEntry<"about">["data"]["history"]>;
};
const {
  history: { title, description, timeline },
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="mx-auto max-w-2xl text-center">
      <h2 set:html={markdownify(title)} />
      {description && <p class="mt-4 text-lg" set:html={markdownify(description)} />}
    </div>

    <ol class="relative mt-14 grid gap-10 lg:grid-cols-3 lg:gap-8">
      <span
        class="absolute bottom-0 left-7 top-0 w-px bg-primary/20 lg:bottom-auto lg:left-0 lg:right-0 lg:top-7 lg:h-px lg:w-auto"
        aria-hidden="true"></span>
      {
        timeline.map((item) => (
          <li class="relative flex flex-col pl-20 lg:pl-0">
            <div class="bg-gradient absolute left-0 top-0 flex h-14 w-14 items-center justify-center rounded-full text-sm font-bold text-white shadow-md ring-8 ring-body lg:relative">
              {item.year}
            </div>
            <div class="flex-1 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:mt-6">
              <h3 class="h5" set:html={markdownify(item.title)} />
              <p class="mt-3" set:html={markdownify(item.content)} />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
