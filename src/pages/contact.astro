---
import PageHeader from "@/components/PageHeader.astro";
import Shape from "@/components/Shape.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getEntry } from "astro:content";
import { FiMail, FiMapPin, FiPhone } from "react-icons/fi";

const contact = await getEntry("contact", "-index");

if (!contact) {
  throw new Error("Contact entry not found for id '-index'.");
}

const { admission } = contact.data;
const page_data = {
  ...contact.data,
  content: contact.body,
};

const { location, email, phone1, phone2 } = config.params;
const mapQuery = encodeURIComponent(`${config.site.title}, ${location}`);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${mapQuery}&z=16&hl=es&output=embed`;
---

<Base
  title={contact.data.meta_title}
  meta_title={contact.data.meta_title}
  description={contact.data.description}
  image={contact.data.image}
>
  <Shape />
  <section class="page-hero pt-16">
    <div class="container">
      <div class="page-hero-content mx-auto max-w-3xl text-center">
        <PageHeader page_data={page_data} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container max-w-6xl">
      <div class="grid gap-8 lg:grid-cols-5">
        <div class="space-y-6 lg:col-span-2">
          <div id="inscripciones" class="bg-gradient rounded-2xl p-7 text-white shadow-md">
            <h2 class="h4 text-white">{admission.title}</h2>
            <p class="mt-3 text-white/90">{admission.description}</p>
            <a
              class="btn btn-white mt-6"
              href={admission.button.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              {admission.button.label}
            </a>
          </div>

          <ul class="space-y-4">
            <li>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <FiMapPin className="h-5 w-5" />
                </span>
                <span>
                  <span class="block text-sm text-text">Dirección</span>
                  <span class="font-medium text-dark">{location}</span>
                </span>
              </a>
            </li>
            <li>
              <a
                href={`mailto:${email}`}
                class="flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <FiMail className="h-5 w-5" />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm text-text">Email</span>
                  <span class="break-all font-medium text-dark">{email}</span>
                </span>
              </a>
            </li>
            <li class="flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <FiPhone className="h-5 w-5" />
              </span>
              <span>
                <span class="block text-sm text-text">Teléfonos</span>
                {
                  [phone1, phone2].map((phone) => (
                    <a
                      href={`tel:${phone.replace(/\s/g, "")}`}
                      class="block font-medium text-dark hover:text-primary"
                    >
                      {phone}
                    </a>
                  ))
                }
              </span>
            </li>
          </ul>
        </div>

        <div class="min-h-95 overflow-hidden rounded-2xl border border-slate-200 shadow-sm lg:col-span-3">
          <iframe
            title={`Mapa de ubicación de ${config.site.title}`}
            src={mapEmbedUrl}
            class="h-full min-h-95 w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </section>
</Base>
